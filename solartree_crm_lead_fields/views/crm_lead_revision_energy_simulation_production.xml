<odoo>
    <record id="view_crm_lead_revision_energy_simulation_production_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.production.tree</field>
        <field name="model">crm.lead.revision.energy.simulation.production</field>
        <field name="arch" type="xml">
            <tree>
                <field name="is_excedentes_prod" invisible="1" column_invisible="1"/>
                <field name="is_produccion_or_autoconsumo" invisible="1" column_invisible="1"/>
                <field name="is_produccion" invisible="1" column_invisible="1"/>
                <field name="revision_id" invisible="1"/>
                <field name="total" readonly="0"
                       invisible="is_excedentes_prod"/>
                <field name="total_calculation" string="Calculados" readonly="0"
                       invisible="is_produccion_or_autoconsumo"/>
                <field name="percentage" readonly="1" widget="percentage"
                       invisible="is_produccion"/>
            </tree>
        </field>
    </record>
    <record id="view_crm_lead_revision_energy_simulation_production_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.production.form</field>
        <field name="model">crm.lead.revision.energy.simulation.production</field>
        <field name="arch" type="xml">
            <form string="Energy Simulation Production">
                <group>
                    <field name="revision_id" invisible="1"/>
                    <field name="total" readonly="0"
                           modifiers="{'invisible': [('type_energy_simulation_production_id.name', 'in', ['Excedentes (Prod.)'])]}"/>
                    <field name="total_calculation" string="Calculados" readonly="0"
                           modifiers="{'invisible': [('type_energy_simulation_production_id.name', 'in', ['Producción', 'Autoconsumo (Prod.)'])]}"/>
                    <field name="percentage" readonly="1" widget="percentage"
                           modifiers="{'invisible': [('type_energy_simulation_production_id.name', 'in', ['Producción'])]}"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_crm_lead_revision_energy_simulation_production_graph" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.production.graph</field>
        <field name="model">crm.lead.revision.energy.simulation.production</field>
        <field name="arch" type="xml">
            <graph string="Energy Simulation Production" disable_linking="1">
                <field name="revision_id"/>
                <field name="type_energy_simulation_production_id" type="row"/>
                <field name="percentage" type="measure"/>
                <field name="kwh_per_year" type="measure"/>
                <field name="total" invisible="1"/>
                <field name="total_calculation" invisible="1"/>
            </graph>
        </field>
    </record>

    <record id="action_crm_lead_revision_energy_simulation_production_graph" model="ir.actions.act_window">
        <field name="name">Energy Simulation Production Graph</field>
        <field name="res_model">crm.lead.revision.energy.simulation.production</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_crm_lead_revision_energy_simulation_production_graph"/>
        <field name="context">{'graph_mode': 'pie'}</field>
        <field name="domain">[('revision_id', '=', active_id)]</field>
    </record>

</odoo>
