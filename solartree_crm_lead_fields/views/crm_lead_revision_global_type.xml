<odoo>
    <record id="view_crm_lead_revision_global_type_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.global.type.tree</field>
        <field name="model">crm.lead.revision.global.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="behavior"/>
            </tree>
        </field>
    </record>
    <record id="view_crm_lead_revision_global_type_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.global.type.form</field>
        <field name="model">crm.lead.revision.global.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="behavior"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_crm_lead_revision_global_type" model="ir.actions.act_window">
        <field name="name">Lead Global Types</field>
        <field name="res_model">crm.lead.revision.global.type</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="submenu_crm_lead_revision_global_type"
              name="Lead Global Types"
              parent="menu_crm_solartree_group"
              action="action_crm_lead_revision_global_type"
              sequence="31"/>
</odoo>
