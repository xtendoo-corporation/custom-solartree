<odoo>
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!--atributos oculto team_id-->
             <xpath expr="//button[@name='%(crm_project_create.crm_create_project_action)d']" position="replace">
             </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_phone_update']" position="after">
                <field name="partner_address_id" domain="[('parent_id', '=', partner_id)]"
                       options="{'no_create': True}"/>
                <field name="partner_address_city" invisible="not partner_address_id"/>
                <field name="partner_address_state_id" invisible="not partner_address_id"/>
                <button
                    class="btn btn-primary"
                    name="open_map"
                    type="object"
                    string="Enlace a la Geolocalización"
                    icon="fa-map-marker"
                    invisible="not partner_address_id"/>
                <separator/>
            </xpath>
            <xpath expr="//field[@name='partner_name']" position="before">
                <field name="partner_address_id" domain="[('parent_id', '=', partner_id)]"
                       options="{'no_create': True}"/>
                <field name="partner_address_city" invisible="not partner_address_id"/>
                <field name="partner_address_state_id" invisible="not partner_address_id"/>
                <button
                    class="btn btn-primary"
                    name="open_map"
                    type="object"
                    string="Enlace a la Geolocalización"
                    icon="fa-map-marker"
                    invisible="not partner_address_id"/>
                <separator/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group>
                    <group string="Solar Tree Information">
                        <field name="approval_margin"
                               groups="solartree_crm_lead_automatization.group_solartree_director"/>
                        <field name="is_technical_office_director" invisible="1"/>
                        <field name="solartree_code" readonly="not is_technical_office_director"/>
                        <!--ESTE CAMPO SOLO SE USA PARA EL EMAIL-->
                        <field name="solartree_lead_type_id_email" invisible="type == 'opportunity'"/>
                        <!--ESTE CAMPO SOLO SE USA PARA EL EMAIL-->
                        <field name="solartree_lead_scope_email" invisible="type == 'opportunity'"/>
                        <!--                        <field name="solartree_lead_type_id" widget="selection"/>-->
                        <!--                        <field name="solartree_lead_modality_id" widget="selection"/>-->
                        <!--                        <field name="solartree_lead_collective"/>-->
                        <!--                        <field name="solartree_lead_storage"/>-->
                        <field name="solartree_num_proyect" invisible="type != 'opportunity' or project_id"/>
                        <field name="project_id" invisible="not project_id" string="Proyecto Asociado" readonly="1"/>
                    </group>
                    <group string="Channels">
                        <!--                        <field name="solartree_lead_scope" widget="selection"/>-->
                        <field name="solartree_lead_channel" widget="selection"/>
                        <!--ESTE CAMPO SOLO SE USA PARA EL EMAIL-->
                        <field name="solartree_lead_channel_fee_email" invisible="type == 'opportunity'"/>
                        <field name="solartree_intern_channel" options="{'no_create': True}"/>
                        <field name="offer_tot"/>
                        <!--ESTE CAMPO SOLO SE USA PARA EL EMAIL-->
                        <field name="solartree_intern_channel_fee_email" invisible="type == 'opportunity'"/>
                        <!--ESTE CAMPO SOLO SE USA PARA EL EMAIL-->
                        <field name="solartree_lead_structure_type" widget="selection"
                               invisible="type == 'opportunity'"/>
                        <!--ESTE CAMPO SOLO SE USA PARA EL EMAIL-->
                        <field name="solartree_lead_structure_model" widget="selection"
                               invisible="type == 'opportunity'"/>
                    </group>
                    <group string="Dates and Deliverables">
                        <field name="solartree_date_request" invisible="type != 'opportunity'"/>
                        <field name="solartree_date_required_delivery"/>
                        <field name="solartree_date_proposed_signature" invisible="type != 'opportunity'"/>
                        <field name="solartree_date_kom" invisible="type != 'opportunity'"/>
                        <field name="solartree_date_visit" invisible="type != 'opportunity'"/>
                        <field name="solartree_date_visit_tecnic" invisible="type != 'opportunity'"/>
                        <field name="solartree_date_deliverables" invisible="type != 'opportunity'"/>
                        <field name="solartree_date_sign_contract" invisible="type != 'opportunity'"/>
                        <field name="solartree_offer_ht" invisible="type != 'opportunity'"/>
                        <field name="design_notes" widget="text" invisible="type != 'opportunity'"/>
                    </group>
                    <group string="Power and Consumption" invisible="type != 'opportunity'">
                        <field name="customer_consumption_mwh"/>
                        <field name="max_power_bie"/>
                        <field name="solartree_cups"/>
                        <field name="extension_rights"/>
                        <field name="access_rights"/>
                        <field name="lead_fee" widget="selection"/>
                        <field name="lead_tension_level" widget="selection"/>
                    </group>
                    <group string="Revisions" invisible="type != 'opportunity'">
                        <field name="selected_revision_id" domain="[('lead_id', '=', id)]"
                               options='{"no_create": True}'/>
                    </group>
                    <group string="Office Tecnic">
                        <field name="solartree_additional_deliverables" widget="text"/>
                        <field name="solartree_connection_point_location" widget="text"/>
                        <field name="solartree_specific_comments" widget="text"/>
                    </group>
                </group>
            </xpath>
            <!--VER SALVADOR VER SALVADOR VER SALVADOR VER SALVADOR VER SALVADOR VER SALVADOR VER SALVADOR-->
            <!--            <xpath expr="//page[@name='lead']" position="attributes">-->
            <!--                <attribute name="invisible">1</attribute>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//group[@name='lead_partner']" position="attributes">-->
            <!--                <attribute name="invisible">1</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_leads_filter_inherit" model="ir.ui.view">
        <field name="name">crm.lead.search.lead</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute
                    name="filter_domain"
                >['|', ('name', 'ilike', self), ('solartree_code', 'ilike', self)]
                </attribute>
            </field>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_inherit" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunity</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute
                    name="filter_domain"
                >['|', ('name', 'ilike', self), ('solartree_code', 'ilike', self)]
                </attribute>
            </field>
        </field>
    </record>

    <record id="action_open_crm_lead_view_form_inherit" model="ir.actions.act_window">
        <field name="name">Open CRM Lead Form Inherit</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm_lead_view_form_inherit"/>
        <field name="target">current</field>
    </record>

    <record id="crm_case_kanban_view_leads_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban.lead.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="on_create">solartree_crm_lead_fields.action_open_crm_lead_view_form_inherit</attribute>
            </xpath>
            <xpath expr="//div[@class='oe_kanban_details']" position="after">
                <hr/>
                <div>
                    <field name="solartree_code_and_revision_selected"/>
                </div>
                <div>
                    <field name="offer_kwp"/>
                    <span> kWp</span>
                    <br/>
                    <field name="installation_sale_price"/>
                    <span> €</span>
                    <br/>
                    <field name="installation_sale_price_wp"/>
                    <span> €/Wp</span>
                    <br/>
                    <field name="solartree_lead_type_id"/>
                    <br/>
                    <field name="offer_class"/>
                </div>
            </xpath>
            <xpath expr="//div[span[@class='o_text_overflow' and @t-if='record.partner_id.value']]" position="replace">
            </xpath>
            <xpath expr="//div[field[@name='tag_ids']]" position="replace">
            </xpath>
            <xpath expr="//div[field[@name='lead_properties']]" position="replace">
            </xpath>
            <xpath expr="//div[@class='o_kanban_record_subtitle']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@class='o_kanban_record_bottom']/div[@class='oe_kanban_bottom_left']" position="replace">
                <div class="oe_kanban_bottom_left"/>
            </xpath>

            <xpath expr="//kanban" position="inside">
                <field name="offer_tot"/>
            </xpath>

            <xpath expr="//div[@class='oe_kanban_bottom_right']" position="inside">
                <field name="offer_tot" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>
            </xpath>

<!--            NUEVO PARA AÑADIR EL TOTAL KWP AL SUM DE LA COLUMNA-->
            <xpath expr="//kanban/progressbar" position="before">
                <field name="total_kwp_accumulated" options="{'suffix': ' kWp'}"/>
                 <progressbar field="activity_state" colors='{"planned": "success", "today": "warning", "overdue": "danger"}'
                             sum_field="total_kwp_accumulated"
                             help="This bar shows the total kWp accumulated."/>
            </xpath>
        </field>
    </record>
</odoo>
