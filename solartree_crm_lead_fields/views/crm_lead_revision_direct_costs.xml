<odoo>
    <record id="view_crm_lead_revision_direct_costs_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.direct.costs.tree</field>
        <field name="model">crm.lead.revision.direct.costs</field>
        <field name="arch" type="xml">
            <tree>
                <field name="lead_id"/>
                <field name="revision_id"/>
                <field name="type_direct_costs_id"
                       domain="[('id', 'not in', selected_type_price_ids), ('behavior', '=', 'direct_costs')]"
                       options="{'no_create': True,}" string=""/>
                <field name="price_cost" widget="monetary"/>
                <field name="price_cost_wp" digits="[16, 4]"/>
                <field name="price_sale" widget="monetary"/>
                <field name="price_sale_wp" digits="[16, 4]"/>
                <field name="selected_type_price_ids" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_revision_direct_costs_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.direct.costs.form</field>
        <field name="model">crm.lead.revision.direct.costs</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type_direct_costs_id"
                               domain="[('id', 'not in', selected_type_price_ids), ('behavior', '=', 'direct_costs')]"
                               options="{'no_create': True,}" string="Type"/>
                        <field name="price_cost" widget="monetary" readonly="0" default_focus="1"/>
                        <field name="price_cost_wp" digits="[16, 4]"/>
                        <field name="price_sale" widget="monetary" readonly="0"/>
                        <field name="price_sale_wp" digits="[16, 4]"/>
                        <field name="selected_type_price_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_lead_revision_direct_costs_graph" model="ir.ui.view">
        <field name="name">crm.lead.revision.direct.costs.graph</field>
        <field name="model">crm.lead.revision.direct.costs</field>
        <field name="arch" type="xml">
            <graph string="Direct Costs">
                <field name="price_cost" type="measure"/>
                <field name="price_sale" type="measure"/>
                 <field name="price_cost_wp" type="measure" invisible="1"/>
                <field name="price_sale_wp" type="measure" invisible="1"/>
                <field name="type_direct_costs_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_crm_lead_revision_direct_costs_graph" model="ir.actions.act_window">
        <field name="name">Direct Costs Graph</field>
        <field name="res_model">crm.lead.revision.direct.costs</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_crm_lead_revision_direct_costs_graph"/>
        <field name="domain">[('revision_id', '=', active_id)]</field>
    </record>

    <record id="action_crm_lead_revision_direct_costs" model="ir.actions.act_window">
        <field name="name">Direct Costs</field>
        <field name="res_model">crm.lead.revision.direct.costs</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <menuitem id="menu_crm_lead_revision_direct_costs"
              name="Direct Costs"
              parent="crm.crm_menu_sales"
              action="action_crm_lead_revision_direct_costs"
              sequence="11"/>
</odoo>
