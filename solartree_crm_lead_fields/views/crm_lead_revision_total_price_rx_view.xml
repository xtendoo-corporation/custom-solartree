<odoo>
    <record id="view_crm_lead_revision_total_price_rx_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.total.price.rx.tree</field>
        <field name="model">crm.lead.revision.total.price.rx</field>
        <field name="arch" type="xml">
            <tree>
                <field name="type_total_price_id" domain="[('id', 'not in', selected_type_total_price_ids), ('behavior', '=', 'total_price')]"
                               options="{'no_create': True,}" string="Tipo"/>
                <field name="price" sum="Total Price RX"/>
                <field name="selected_type_total_price_ids" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_revision_total_price_rx_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.total.price.rx.form</field>
        <field name="model">crm.lead.revision.total.price.rx</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type_total_price_id" domain="[('id', 'not in', selected_type_total_price_ids), ('behavior', '=', 'total_price')]"
                               options="{'no_create': True,}" string="Tipo"/>
                        <field name="price" sum="Total Price RX"/>
                        <field name="selected_type_total_price_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
