<odoo>
    <record id="view_crm_lead_revision_energy_simulation_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.tree</field>
        <field name="model">crm.lead.revision.energy.simulation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="is_excedentes_prod_or_red_dem" invisible="1" column_invisible="1"/>
                <field name="is_produccion_or_autoconsumo_or_demanda" invisible="1" column_invisible="1"/>
                <field name="is_produccion_or_demanda" invisible="1" column_invisible="1"/>
                <field name="revision_id" invisible="1"/>
                <field name="total" readonly="0"
                       invisible="is_excedentes_prod_or_red_dem"/>
                <field name="total_calculation" string="Calculados" readonly="0"
                       invisible="is_produccion_or_autoconsumo_or_demanda"/>
                <field name="percentage" readonly="1" widget="percentage"
                       invisible="is_produccion_or_demanda"/>
            </tree>
        </field>
    </record>
    <record id="view_crm_lead_revision_energy_simulation_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.form</field>
        <field name="model">crm.lead.revision.energy.simulation</field>
        <field name="arch" type="xml">
            <form string="Energy Simulation">
                <group>
                    <field name="revision_id" invisible="1"/>
                    <field name="total" readonly="0"
                           modifiers="{'invisible': [('type_energy_simulation_id.name', 'in', ['Excedentes (Prod.)', 'Red (Dem.)'])]}"/>
                    <field name="total_calculation" string="Calculados" readonly="0"
                           modifiers="{'invisible': [('type_energy_simulation_id.name', 'in', ['Producción', 'Autoconsumo (Prod.)', 'Demanda', 'Autoconsumo (Dem.)'])]}"/>
                    <field name="percentage" readonly="1" widget="percentage"
                           modifiers="{'invisible': [('type_energy_simulation_id.name', 'in', ['Producción', 'Demanda'])]}"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_crm_lead_revision_energy_simulation_graph" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.graph</field>
        <field name="model">crm.lead.revision.energy.simulation</field>
        <field name="arch" type="xml">
            <graph string="Energy Simulation">
                <field name="revision_id"/>
                <field name="total" type="measure"/>
                <field name="total_calculation" type="measure"/>
                <field name="percentage" type="measure"/>
                <field name="type_energy_simulation_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_crm_lead_revision_energy_simulation_graph" model="ir.actions.act_window">
        <field name="name">Energy Simulation Graph</field>
        <field name="res_model">crm.lead.revision.energy.simulation</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_crm_lead_revision_energy_simulation_graph"/>
        <field name="context">{'graph_mode': 'pie'}</field>
        <field name="domain">[('revision_id', '=', active_id)]</field>
    </record>

    <record id="action_crm_lead_energy_simulation" model="ir.actions.act_window">
        <field name="name">Lead Energy Simulation</field>
        <field name="res_model">crm.lead.revision.energy.simulation</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="submenu_crm_lead_energy_simulation"
              name="Lead Energy Simulation"
              parent="menu_crm_solartree_group"
              action="action_crm_lead_energy_simulation"
              sequence="33"/>
</odoo>
