<odoo>
    <record id="view_crm_lead_revision_energy_simulation_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.tree</field>
        <field name="model">crm.lead.revision.energy.simulation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="revision_id" invisible="1"/>
                <field name="total" readonly="0"/>
                <field name="total_calculation" readonly="0"/>
                <field name="percentage" readonly="0" widget="percentage"/>
            </tree>
        </field>
    </record>
    <record id="view_crm_lead_revision_energy_simulation_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.energy.simulation.form</field>
        <field name="model">crm.lead.revision.energy.simulation</field>
        <field name="arch" type="xml">
            <form string="Energy Simulation">
                <group>
                    <field name="revision_id" invisible="1"/>
                    <field name="total" readonly="0"/>
                    <field name="total_calculation" readonly="0"/>
                    <field name="percentage" readonly="0" widget="percentage"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_energy_simulation" model="ir.actions.act_window">
        <field name="name">Lead Energy Simulation</field>
        <field name="res_model">crm.lead.revision.energy.simulation</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="submenu_crm_lead_energy_simulation"
              name="Lead Energy Simulation"
              parent="menu_crm_solartree_group"
              action="action_crm_lead_energy_simulation"
              sequence="33"/>
</odoo>
