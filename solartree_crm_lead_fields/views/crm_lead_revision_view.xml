<odoo>
    <record id="view_crm_lead_revision_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.tree</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <tree string="Revisions">
                <field name="offer_selected" widget="boolean_toggle"/>
                <field name="lead_id"/>
                <field name="name"/>
                <field name="offer_kwp"/>
                <field name="offer_kwn"/>
                <field name="offer_storage_kwh"/>
                <field name="offer_storage_kwn"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_revision_graph" model="ir.ui.view">
        <field name="name">crm.lead.revision.graph</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <graph string="Revisions Graph">
                <field name="revision_inverter_ids"/>
                <field name="revision_battery_ids"/>
                <field name="revision_price_ids"/>
                <field name="revision_direct_costs_ids"/>
                <field name="revision_energy_simulation_production_ids"/>
                <field name="revision_energy_simulation_demand_ids"/>
            </graph>
        </field>
    </record>


    <record id="action_crm_lead_revision_graph" model="ir.actions.act_window">
        <field name="name">Revisions Graph</field>
        <field name="res_model">crm.lead.revision</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_crm_lead_revision_graph"/>
    </record>

    <record id="view_crm_lead_revision_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.form</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <form string="Revision">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_crm_lead_revision_direct_costs_graph)d" string="Costes Directos"
                                type="action"
                                class="oe_stat_button" icon="fa-bar-chart"/>
                        <button name="%(action_crm_lead_revision_energy_simulation_production_graph)d" string="Simulación Energía Producción"
                                type="action"
                                class="oe_stat_button" icon="fa-bar-chart"/>
                        <button name="%(action_crm_lead_revision_energy_simulation_demand_graph)d" string="Simulación Energía Demanda"
                                type="action"
                                class="oe_stat_button" icon="fa-bar-chart"/>
                    </div>
                    <group>
                        <field name="name" readonly="0"/>
                    </group>
                    <group colspan="4">
                        <group name="Offer Data" string="Offer Data">
                            <field name="lead_id" readonly="1"/>
                            <field name="solartree_lead_type_id"/>
                            <field name="solartree_lead_scope"/>
                            <field name="solartree_lead_modality_id"/>
                            <field name="solartree_lead_collective"/>
                        </group>
                        <group string="">
                            <field name="solartree_lead_storage"/>
                            <field name="solartree_lead_structure_type"/>
                            <field name="solartree_lead_structure_model"/>
                            <!--                            <field name="offer_class"/>-->
                            <field name="offer_class_id" widget="selection" readonly="1"/>
                        </group>
                        <group name="Revision fields" string="Revision fields">
                            <field name="offer_kwp" readonly="0"/>
                            <field name="offer_kwn" readonly="0"/>
                            <field name="offer_storage_kwh"/>
                            <field name="offer_storage_kwn"/>
                            <field name="offer_ve_kwn"/>
                            <field name="offer_tot" widget="selection"/>
                            <field name="offer_HT"/>
                            <field name="offer_date_deliver"/>
                            <field name="offer_evacuation" widget="selection"/>
                        </group>
                        <group name="Revision fields 2" string="">
                            <field name="avg_price" string="Precio medio (€/kWh)"/>
                            <field name="surplus_price" string="Precio excedente (€/kWh)"/>
                            <field name="offer_fabricant_modules" widget="text"/>
                            <field name="offer_modules_model" widget="text"/>
                            <field name="offer_modules_unit_power" string="Potencia unitaria (Wp)"/>
                            <field name="offer_modules_quantity"/>
                            <field name="offer_structure_manufacturer" widget="text"/>
                            <field name="offer_structure_description" widget="text"/>
                        </group>
                        <group name="invertes" string="Inverters">
                            <field name="offer_inverter_manufacturer" widget="text"/>
                            <field name="revision_inverter_ids" string="">
                                <tree editable="bottom">
                                    <field name="offer_inverter_model"/>
                                    <field name="offer_inverter_unit_power"/>
                                    <field name="offer_inverter_quantity"/>
                                </tree>
                            </field>
                        </group>
                        <group invisible="solartree_lead_storage"/>
                        <group name="battery" string="Battery" invisible="not solartree_lead_storage">
                            <field name="offer_battery_manufacturer" widget="text"/>
                            <field name="revision_battery_ids" string="">
                                <tree editable="bottom">
                                    <field name="offer_battery_model"/>
                                    <field name="offer_battery_capacity"/>
                                    <field name="offer_battery_power"/>
                                    <field name="offer_battery_quantity"/>
                                </tree>
                            </field>
                        </group>
                        <group name="rentability" string="Rentability">
                            <field name="offer_pb_actual"/>
                            <field name="offer_pb_omip"/>
                            <field name="offer_pb_proyection"/>
                            <field name="pb_exced_min"/>
                            <field name="pb_battery" string="PB Batería" invisible="not solartree_lead_storage"/>
                        </group>
                        <group name="rentability2" string="">
                            <field name="offer_tir_actual" digits="[16, 1]"/>
                            <field name="offer_tir_omip" digits="[16, 1]"/>
                            <field name="offer_tir_proyection" digits="[16, 1]"/>
                            <field name="tir_exced_min" digits="[16, 1]"/>
                            <field name="tir_battery" string="TIR Batería %" invisible="not solartree_lead_storage"/>
                        </group>
                        <group name="fees_and_margins" string="FEEs y Márgenes">
                            <field name="revision_price_ids" string="">
                                <tree editable="bottom">
                                    <field name="type_price_id" options="{'no_create': True,}" string=""/>
                                    <field name="percentage" widget="percentage" readonly="0"/>
                                    <field name="price" widget="monetary" string="€"/>
                                    <field name="price_wp" digits="[16, 4]" string="€/Wp"/>
                                </tree>
                            </field>
                        </group>
                        <group name="direct_costs" string="Direct Costs">
                            <field name="revision_direct_costs_ids" string="">
                                <tree editable="bottom">
                                    <field name="type_direct_costs_id" options="{'no_create': True,}" string=""/>
                                    <field name="price_cost" widget="monetary" readonly="0"/>
                                    <field name="price_cost_wp" digits="[16, 4]"/>
                                    <field name="price_sale" widget="monetary" readonly="0"/>
                                    <field name="price_sale_wp" digits="[16, 4]"/>
                                </tree>
                            </field>
                        </group>
                        <group name="total_price" string="Precio Total">
                            <field name="installation_cost_price" widget="monetary" string="Coste de Instalación (€)"
                                   readonly="0"/>
                            <field name="installation_cost_price_wp" widget="float" digits="[16, 4]"
                                   string="(€/Wp)" readonly="0"/>
                            <field name="installation_sale_price" string="Venta de instalación (€)" readonly="0"/>
                            <field name="installation_sale_price_wp" string="(€/Wp)" readonly="0"/>
                            <field name="offer_fv" string="Precio de venta FV"/>
                            <field name="tax_id"/>
                            <field name="installation_sale_price_with_tax" string="Venta de instalación con iva (€)"
                                   readonly="0"/>
                        </group>

                        <group name="energy" string="Simulación Energía">
                            <field name="revision_energy_simulation_production_ids" string="">
                                <tree editable="bottom" >
                                    <field name="is_excedentes_prod" invisible="1" column_invisible="1"/>
                                    <field name="is_produccion_or_autoconsumo" invisible="1" column_invisible="1"/>
                                    <field name="is_produccion" invisible="1" column_invisible="1"/>
                                    <field name="type_energy_simulation_production_id" options="{'no_create': True,}" string=""/>
                                    <field name="total" readonly="0"
                                           invisible="is_excedentes_prod"/>
                                    <field name="total_calculation" string="Calculados" readonly="0"
                                           invisible="is_produccion_or_autoconsumo"/>
                                    <field name="percentage" readonly="1" widget="percentage"
                                           invisible="is_produccion"/>
                                </tree>
                            </field>
                             <field name="revision_energy_simulation_demand_ids" string="">
                                <tree editable="bottom" >
                                    <field name="is_red_dem" invisible="1" column_invisible="1"/>
                                    <field name="is_autoconsumo_or_demanda" invisible="1" column_invisible="1"/>
                                    <field name="is_demanda" invisible="1" column_invisible="1"/>
                                    <field name="type_energy_simulation_demand_id" options="{'no_create': True,}" string=""/>
                                    <field name="total" readonly="0"
                                           invisible="is_red_dem"/>
                                    <field name="total_calculation" string="Calculados" readonly="0"
                                           invisible="is_autoconsumo_or_demanda"/>
                                    <field name="percentage" readonly="1" widget="percentage"
                                           invisible="is_demanda"/>
                                </tree>
                            </field>
                        </group>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_crm_lead_revision_pivot" model="ir.ui.view">
        <field name="name">crm.lead.revision.pivot</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <pivot string="Revisions">
                <field name="offer_kwp" type="measure"/>
                <field name="offer_kwn" type="measure"/>
                <field name="offer_storage_kwh" type="measure"/>
                <field name="offer_storage_kwn" type="measure"/>
                <field name="offer_self_consumption" type="measure"/>
                <field name="offer_self_consumption" type="measure"/>
                <field name="customer_consumption_mwh" type="measure"/>
                <field name="name" type="row"/>
                <field name="solartree_lead_type_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="crm_case_form_view_oppor_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherited.crm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_schedule_meeting']" position="after">
                <button class="oe_stat_button" type="object" name="action_view_revisions" icon="fa-eye"
                        string="Revisiones"
                        invisible="type == 'lead'">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="revision_count" widget="statinfo"/>
                        </span>
                    </div>
                </button>
                <button class="oe_stat_button" type="object" name="action_create_project_from_revision" icon="fa-folder-open"
                        string="Crear Proyecto"
                        invisible="type == 'lead'"/>
            </xpath>
        </field>
    </record>

    <record id="action_crm_lead_revision" model="ir.actions.act_window">
        <field name="name">Revisions</field>
        <field name="res_model">crm.lead.revision</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <!-- Add the menu item under crm.crm_menu_sales -->
    <menuitem id="menu_crm_lead_revision"
              name="Revisions"
              parent="crm.crm_menu_sales"
              action="action_crm_lead_revision"
              sequence="10"/>

</odoo>
