<odoo>
    <record id="view_crm_lead_revision_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.tree</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <tree string="Revisions">
                <field name="name"/>
                <field name="offer_kwp"/>
                <field name="offer_kwn"/>
                <field name="offer_storage_kwh"/>
                <field name="offer_storage_kwn"/>
                <field name="offer_wp"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_revision_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.form</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <form string="Revision">
                <sheet>
                    <group>
                        <field name="name" readonly="0"/>
                    </group>
                    <group colspan="4">
                        <group name="Offer Data" string="Offer Data">
                            <field name="lead_id" readonly="1"/>
                            <field name="solartree_lead_type_id"/>
                            <field name="solartree_lead_scope"/>
                            <field name="solartree_lead_modality_id"/>
                            <field name="solartree_lead_collective"/>
                        </group>
                        <group string="">
                            <field name="solartree_lead_storage"/>
                            <field name="solartree_lead_structure_type"/>
                            <field name="solartree_lead_structure_model"/>
                            <field name="offer_class"/>
                        </group>
                        <group name="Revision fields" string="Revision fields">
                            <field name="offer_kwp" readonly="0"/>
                            <field name="offer_kwn" readonly="0"/>
                            <field name="offer_storage_kwh"/>
                            <field name="offer_storage_kwn"/>
                            <field name="offer_ve_kwn"/>
                            <field name="offer_kwh_year"/>
                            <field name="offer_tot" widget="selection"/>
                            <field name="offer_HT"/>
                            <field name="offer_date_deliver"/>
                            <field name="offer_evacuation" widget="selection"/>
                        </group>
                        <group name="Revision fields 2" string="">
                            <field name="avg_price" string="Precio medio (€/kWh)"/>
                            <field name="surplus_price" string="Precio excedente (€/kWh)"/>
                            <field name="offer_fabricant_modules" widget="text"/>
                            <field name="offer_modules_model" widget="text"/>
                            <field name="offer_modules_unit_power" string="Potencia unitaria (Wp)"/>
                            <field name="offer_modules_quantity"/>
                            <field name="offer_structure_manufacturer" widget="text"/>
                            <field name="offer_structure_description" widget="text"/>
                            <field name="offer_wp"/>
                        </group>
                        <group name="invertes" string="Inverters">
                            <field name="offer_inverter_manufacturer" widget="text"/>
                            <field name="revision_inverter_ids" string="">
                                <tree>
                                    <field name="offer_inverter_model"/>
                                    <field name="offer_inverter_unit_power"/>
                                    <field name="offer_inverter_quantity"/>
                                </tree>
                            </field>
                        </group>
                        <group invisible="solartree_lead_storage"/>
                        <group name="battery" string="Battery" invisible="not solartree_lead_storage">
                            <field name="offer_battery_manufacturer" widget="text"/>
                            <field name="revision_battery_ids" string="">
                                <tree>
                                    <field name="offer_battery_model"/>
                                    <field name="offer_battery_capacity"/>
                                    <field name="offer_battery_power"/>
                                    <field name="offer_battery_quantity"/>
                                </tree>
                            </field>
                        </group>
                        <group name="rentability" string="Rentability">
                            <field name="offer_pb_actual"/>
                            <field name="offer_pb_omip"/>
                            <field name="offer_pb_proyection"/>
                            <field name="pb_exced_min"/>
                        </group>
                        <group name="rentability2" string="">
                            <field name="offer_tir_actual" digits="[16, 1]"/>
                            <field name="offer_tir_omip" digits="[16, 1]"/>
                            <field name="offer_tir_proyection" digits="[16, 1]"/>
                            <field name="tir_exced_min" digits="[16, 1]"/>
                        </group>
                        <group name="fees_and_margins" string="FEEs y Márgenes">
                            <field name="revision_price_ids" string="">
                                <tree>
                                    <field name="type_price_id" options="{'no_create': True,}" string=""/>
                                    <field name="percentage" widget="percentage" readonly="0"/>
                                    <field name="price" widget="monetary" string="€"/>
                                    <field name="price_wp" digits="[16, 4]" string="€/Wp"/>
                                </tree>
                            </field>
                        </group>
                        <group name="direct_costs" string="Direct Costs">
                            <field name="revision_direct_costs_ids" string="">
                                <tree>
                                    <field name="type_direct_costs_id" options="{'no_create': True,}" string=""/>
                                    <field name="price_cost" widget="monetary" readonly="0"/>
                                    <field name="price_cost_wp" digits="[16, 4]"/>
                                    <field name="price_sale" widget="monetary" readonly="0"/>
                                    <field name="price_sale_wp" digits="[16, 4]"/>
                                </tree>
                            </field>
                        </group>
                         <group name="total_price" string="Precio Total">
                           <field name="installation_cost_price" widget="monetary" string="Coste de Instalación (€)"
                                   readonly="0"/>
                           <field name="installation_cost_price_wp" widget="float" digits="[16, 4]"
                                   string="(€/Wp)" readonly="0"/>
                           <field name="installation_sale_price" string="Venta de instalación (€)" readonly="0"/>
                           <field name="installation_sale_price_wp" string="(€/Wp)" readonly="0"/>
                           <field name="offer_fv" string="Precio de venta FV"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_case_form_view_oppor_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherited.crm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_schedule_meeting']" position="after">
                <button class="oe_stat_button" type="object" name="action_view_revisions" icon="fa-eye"
                        string="Revisiones"
                        invisible="type == 'lead'">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="revision_count" widget="statinfo"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
