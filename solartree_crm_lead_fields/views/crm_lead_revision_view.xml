<odoo>
    <record id="view_crm_lead_revision_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.tree</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <tree string="Revisions">
                <field name="name"/>
                <field name="offer_kwp"/>
                <field name="offer_kwn"/>
                <field name="offer_storage_kwh"/>
                <field name="offer_storage_kwn"/>
                <field name="offer_wp"/>
                <!--                <field name="offer_mbsv" widget="percentage"/>-->
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_revision_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.form</field>
        <field name="model">crm.lead.revision</field>
        <field name="arch" type="xml">
            <form string="Revision">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="lead_id" readonly="1"/>
                    </group>
                    <group colspan="4">
                        <group>
                            <field name="offer_kwp"/>
                            <field name="offer_kwn"/>
                            <field name="offer_storage_kwh"/>
                            <field name="offer_storage_kwn"/>
                            <field name="offer_ve_kwn"/>
                            <field name="offer_class"/>
                            <field name="solartree_lead_type_id"/>
                            <field name="solartree_lead_scope"/>
                            <field name="solartree_lead_modality_id"/>
                            <field name="solartree_lead_collective"/>
                            <field name="solartree_lead_storage"/>
                            <field name="solartree_lead_structure_type"/>
                            <field name="solartree_lead_structure_model"/>
                        </group>
                        <group>
                            <field name="offer_kwh_year"/>
                            <field name="offer_fv_price" widget="monetary"/>
                            <field name="offer_wp"/>
                            <field name="offer_pb_actual"/>
                            <field name="offer_tir_actual" widget="percentage"/>
                            <field name="offer_pb_omip"/>
                            <field name="offer_tir_omip" widget="percentage"/>
                            <field name="offer_pb_proyection"/>
                            <field name="offer_tir_proyection" widget="percentage"/>
                            <field name="offer_storage_price" widget="monetary"/>
                            <field name="offer_ve_price" widget="monetary"/>
                            <field name="offer_price_rx" widget="monetary"/>
                        </group>
                        <group>
                            <field name="offer_tot" widget="selection"/>
                            <field name="offer_HT"/>
                            <field name="offer_date_deliver"/>
                            <!--                            <field name="offer_fee_external" widget="percentage"/>-->
                            <!--                            <field name="offer_fee_internal" widget="percentage"/>-->
                            <!--                            <field name="offer_gg" widget="percentage"/>-->
                            <!--                            <field name="offer_bi" widget="percentage"/>-->
                            <!--                            <field name="offer_mbsv" widget="percentage"/>-->
                        </group>
                        <group>
                            <field name="offer_evacuation" widget="selection"/>

                            <field name="revision_price_ids">
                                <tree string="Revision Prices">
                                    <field name="revision_id"/>
                                    <field name="type_price_id"/>
                                    <field name="field_default"/>
                                    <field name="field_default_value"/>
                                    <field name="field_default_2"/>
                                    <field name="field_default_value_2"/>
                                    <field name="field_default_3"/>
                                    <field name="field_default_value_3"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_case_form_view_oppor_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherited.crm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_schedule_meeting']" position="after">
                <button class="oe_stat_button" type="object" name="action_view_revisions" icon="fa-eye"
                        string="Revisiones"
                        invisible="type == 'lead'">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="revision_count" widget="statinfo"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
