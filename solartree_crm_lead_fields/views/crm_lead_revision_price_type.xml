<odoo>
    <record id="view_crm_lead_revision_price_type_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.price.type.tree</field>
        <field name="model">crm.lead.revision.price.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_revision_price_type_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.price.type.form</field>
        <field name="model">crm.lead.revision.price.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_revision_price_type" model="ir.actions.act_window">
        <field name="name">Lead Economic</field>
        <field name="res_model">crm.lead.revision.price.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="submenu_crm_lead_revision_price_type"
              name="Lead Economic"
              parent="menu_crm_solartree_group"
              action="action_crm_lead_revision_price_type"
              sequence="31"/>

</odoo>
