<odoo>
    <record id="view_crm_lead_revision_prices_tree" model="ir.ui.view">
        <field name="name">crm.lead.revision.prices.tree</field>
        <field name="model">crm.lead.revision.prices</field>
        <field name="arch" type="xml">
            <tree>
                <field name="type_price_id" domain="[('id', 'not in', selected_type_price_ids), ('behavior', '=', 'fee_and_margins')]"
                       options="{'no_create': True,}" string=""/>
                <field name="percentage" widget="percentage" readonly="0"/>
                <field name="price" widget="monetary"/>
                <field name="price_wp" digits="[16, 4]"/>
                <field name="selected_type_price_ids" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_revision_prices_form" model="ir.ui.view">
        <field name="name">crm.lead.revision.prices.form</field>
        <field name="model">crm.lead.revision.prices</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type_price_id" domain="[('id', 'not in', selected_type_price_ids), ('behavior', '=', 'fee_and_margins')]"
                               options="{'no_create': True,}" string="Tipo"/>
                        <field name="percentage" widget="percentage" readonly="0"/>
                        <field name="price" widget="monetary"/>
                        <field name="price_wp" digits="[16, 4]"/>
                        <field name="selected_type_price_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
