<odoo>

    <record id="view_contact_profile_tree" model="ir.ui.view">
        <field name="name">contact.profile.tree</field>
        <field name="model">contact.profile</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_contact_profile_form" model="ir.ui.view">
        <field name="name">contact.profile.form</field>
        <field name="model">contact.profile</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_contact_profile" model="ir.actions.act_window">
        <field name="name">Contact Profile</field>
        <field name="res_model">contact.profile</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
