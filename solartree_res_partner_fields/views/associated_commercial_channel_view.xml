<odoo>

    <record id="view_associated_commercial_channel_tree" model="ir.ui.view">
        <field name="name">associated.commercial.channel.tree</field>
        <field name="model">associated.commercial.channel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_associated_commercial_channel_form" model="ir.ui.view">
        <field name="name">associated.commercial.channel.form</field>
        <field name="model">associated.commercial.channel</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_associated_commercial_channel" model="ir.actions.act_window">
        <field name="name">Associated Commercial Channel</field>
        <field name="res_model">associated.commercial.channel</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
