<odoo>

    <record id="view_industrial_contact_tree" model="ir.ui.view">
        <field name="name">industrial.contact.tree</field>
        <field name="model">industrial.contact</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_industrial_contact_form" model="ir.ui.view">
        <field name="name">industrial.contact.form</field>
        <field name="model">industrial.contact</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_industrial_contact" model="ir.actions.act_window">
        <field name="name">Industrial Contact</field>
        <field name="res_model">industrial.contact</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
