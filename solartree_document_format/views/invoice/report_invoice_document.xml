<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <!-- Documento -->
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="after">
            <t t-set="project"  t-value="o._get_invoice_project()"/>
            <div t-if="project">
                <span>Proyecto: <span t-esc="project.name"/></span>
            </div>
        </xpath>

        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="after">
            <t t-set="project"  t-value="o._get_invoice_project()"/>
            <div t-if="project">
                <span>Proyecto: <span t-esc="project.name"/></span>
            </div>
        </xpath>

        <xpath expr="//th[@name='th_quantity']" position="replace">
        </xpath>
        <xpath expr="//th[@name='th_priceunit']" position="replace">
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="replace">
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
        </xpath>
<!--        <xpath expr="//th[@name='th_subtotal']" position="replace">-->
<!--        </xpath>-->

        <xpath expr="//td[@name='td_quantity']" position="replace">
        </xpath>
        <xpath expr="//td[@name='td_price_unit']" position="replace">
        </xpath>
        <xpath expr="//td[@name='td_discount']" position="replace">
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="replace">
        </xpath>
<!--        <xpath expr="//td[@name='td_subtotal']" position="replace">-->
<!--        </xpath>-->

        <xpath expr="//p[@name='payment_communication']" position="replace">
        </xpath>
    </template>
</odoo>
