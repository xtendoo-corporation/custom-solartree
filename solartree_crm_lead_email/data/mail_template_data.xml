<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_data_crm_lead_email" model="mail.template">
            <field name="name">Email when opportunity is won</field>
            <field name="model_id" ref="model_crm_lead"/>
            <field name="subject">Firma de Contrato {{object.name}}</field>
            <field name="email_to">{{object.all_users_emails}}</field>
            <field name="description">Email sent to the customer when an opportunity is won.</field>
            <field name="body_html" type="html">
                <p>Hola</p>
                <p>Gracias por su interés.</p>
                <p>En breve nos pondremos en contacto con usted.</p>
                <p>Gracias,</p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
