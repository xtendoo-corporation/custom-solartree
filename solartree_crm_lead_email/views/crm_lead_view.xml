<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_crm_lead_form_email_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.email.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!--Boton de oportunidad ganada-->
            <field name="stage_id" position="before">
                <button
                    name="action_crm_lead_send_email_won"
                    string="Notificar Oportunidad Ganada"
                    type="object"
                    groups="base.group_user"
                    invisible="not active or probability != 100 or type == 'lead'"/>
            </field>
            <!--Boton de notificar peticion de oferta-->
            <field name="stage_id" position="before">
                <button
                    name="action_crm_lead_send_email_request"
                    string="Notificar Petición de Oferta"
                    type="object"
                    groups="base.group_user"
                    invisible="type == 'opportunity' or not active"/>
            </field>
        </field>
    </record>
</odoo>
