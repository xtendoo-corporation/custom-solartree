        <!-- Nueva categoría para Solartree -->
        <record id="module_category_solartree" model="ir.module.category">
            <field name="name">Solartree</field>
            <field name="sequence">10</field>
        </record>

        <!-- Grupos para Desarrollo de Negocio -->
        <record id="group_crm_business_user" model="res.groups">
            <field name="name">Usuario de desarrollo de Negocio</field>
