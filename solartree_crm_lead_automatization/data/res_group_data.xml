        <!-- Grupos para Oficina Técnica -->
        <record id="group_crm_technical_office_user" model="res.groups">
            <field name="name">Usuario de oficina Técnica</field>
            <field name="category_id" ref="module_category_solartree"/>
        </record>
        <record id="group_crm_technical_office_director" model="res.groups">
            <field name="name">Director de oficina Técnica</field>
            <field name="category_id" ref="module_category_solartree"/>
        </record>

        <!-- Grupos para Solartree -->
        <record id="group_solartree_director" model="res.groups">
            <field name="name">Director de Solartree</field>
            <field name="category_id" ref="module_category_solartree"/>
        </record>

    </data>
</odoo>
