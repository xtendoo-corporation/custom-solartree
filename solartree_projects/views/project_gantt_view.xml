<odoo>
    <record id="project_project_view_gantt_inherit" model="ir.ui.view">
        <field name="name">Project Gantt</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_enterprise.project_project_view_gantt"/>
        <field name="arch" type="xml">
            <xpath expr="//gantt" position="replace">
                 <gantt date_start="start_date_planned"
                date_stop="installation_date_end"
                default_scale="month"
                scales="week,month,year"
                color="stage_id"
                string="Planning"
                display_unavailability="1"
                precision="{'week': 'day:full', 'month': 'day:full'}"
                default_group_by="user_id"
                thumbnails="{'user_id': 'avatar_128'}"
                total_row="True">
                <templates>
                    <div t-name="gantt-popover">
                        <div t-if="user_id"><strong>Project Manager — </strong> <t t-esc="user_id[1]"/></div>
                        <div t-if="partner_id"><strong>Customer — </strong> <t t-esc="partner_id[1]"/></div>
                        <div>
                            <t t-esc="start_date_planned.toFormat('D ')"/>
                            <i class="fa fa-long-arrow-right" title="Arrow"/>
                            <t t-esc="installation_date_end.toFormat(' D')"/>
                        </div>
                    </div>
                </templates>
                <field name="user_id"/>
                <field name="partner_id"/>
            </gantt>
            </xpath>
        </field>
    </record>
</odoo>
